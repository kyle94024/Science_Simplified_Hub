# Partner-form delivery (same Gmail SMTP approach as the Science Simplified platform).
# Use a Google App Password, not the account password.
EMAIL_USER=info@scisimplified.org
EMAIL_PASS=

# Where partner enquiries land. Defaults to EMAIL_USER when unset.
CONTACT_TO=info@scisimplified.org

# Canonical origin, used for metadata and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://www.scisimplified.org
